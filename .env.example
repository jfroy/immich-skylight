# --- Immich ---
IMMICH_URL=https://photos.example.com
IMMICH_API_KEY=changeme            # Immich > Account Settings > API Keys (needs asset.read, asset.download, tag.read)
IMMICH_FAVORITES=true              # sync favorited photos
IMMICH_TAGS=                       # comma-separated tag names or paths, e.g. "Skylight" or "Family/Skylight"
IMMICH_IMAGE_SOURCE=preview        # preview (default, ~1440px JPEG) | fullsize | original
INCLUDE_VIDEOS=false
# Per-frame tag created in Immich (Go template; .Name/.ID). Photos with it go to that frame only. Empty disables.
IMMICH_FRAME_TAG_TEMPLATE=Skylight/{{ .Name }}
PRUNE_FRAME_TAGS=false             # delete a frame's tag when the frame is no longer a target (needs tag.delete)

# --- Skylight ---
SKYLIGHT_EMAIL=you@example.com
SKYLIGHT_PASSWORD=changeme
SKYLIGHT_FRAME_IDS=                # optional; run `immich-skylight frames` to list. Auto-selected if you have one frame.
SKYLIGHT_FRAME_NAMES=              # optional alternative, e.g. "Kitchen"
SKYLIGHT_CAPTION=true              # use the Immich description as the photo caption
REMOVE_UNSELECTED=false            # delete photos from the frame when un-favorited/untagged in Immich

# --- Runtime ---
SYNC_INTERVAL=15m
STATE_FILE=/data/state.db
DRY_RUN=false
LOG_LEVEL=info

# --- Observability ---
HTTP_ADDR=:8080                    # /metrics, /healthz, /readyz, /webhook
WEBHOOK_SECRET=                    # set to enable POST /webhook for Immich Workflows (header X-Webhook-Secret)
OTEL_SERVICE_NAME=immich-skylight
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # enables OTLP traces+metrics+logs
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=homelab
